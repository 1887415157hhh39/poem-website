{
  "name": "wengu-poetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-cloud-config.mjs && npm run check:pinyin && vite build && node scripts/prepare-sites-build.mjs",
    "prepare:pinyin": "node scripts/prepare-pinyin.mjs",
    "check:pinyin": "node scripts/prepare-pinyin.mjs --check",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/corpus.test.mjs tests/study.test.mjs tests/sync.test.mjs tests/database.test.mjs tests/cloud-config.test.mjs tests/pinyin.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@pinyin-pro/data": "1.3.1",
    "@playwright/test": "^1.64.1",
    "pinyin-pro": "3.29.5"
  }
}
